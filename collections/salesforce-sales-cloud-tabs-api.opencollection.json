{
  "opencollection": "1.0.0",
  "info": {
    "name": "Salesforce Sales Cloud Salesforce Analytics REST Change Events Tabs API",
    "version": "59.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://login.salesforce.com/services/oauth2/authorize",
      "accessTokenUrl": "https://login.salesforce.com/services/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Tabs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Salesforce Sales Cloud Get available tabs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v59.0/analytics/tabs"
          },
          "docs": "Returns a list of all tabs available to the current user, including custom tabs and standard tabs. Includes tab metadata such as icon URLs, colors, and whether the tab is custom."
        }
      ]
    }
  ],
  "bundled": true
}