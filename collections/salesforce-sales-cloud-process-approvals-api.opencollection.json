{
  "opencollection": "1.0.0",
  "info": {
    "name": "Salesforce Sales Cloud Salesforce Analytics REST Change Events Process Approvals API",
    "version": "59.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://login.salesforce.com/services/oauth2/authorize",
      "accessTokenUrl": "https://login.salesforce.com/services/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Process Approvals",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Salesforce Sales Cloud Get pending process approvals",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v59.0/analytics/process/approvals"
          },
          "docs": "Returns a list of all approval processes and their current state. Available in API version 30.0 and later."
        },
        {
          "info": {
            "name": "Salesforce Sales Cloud Submit a process approval request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{instance}.salesforce.com/services/data/v59.0/analytics/process/approvals",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submits a particular record for approval, approves or rejects an approval request, or processes bulk approval requests."
        }
      ]
    }
  ],
  "bundled": true
}