{
  "opencollection": "1.0.0",
  "info": {
    "name": "Salesforce Sales Cloud Salesforce Analytics REST Change Events Feeds API",
    "version": "59.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://login.salesforce.com/services/oauth2/authorize",
      "accessTokenUrl": "https://login.salesforce.com/services/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Feeds",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Salesforce Sales Cloud Get news feed for current user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v59.0/analytics/chatter/feeds/news/me/feed-elements",
            "params": [
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Number of items per page (default 25, max 100)"
              },
              {
                "name": "pageToken",
                "value": "",
                "type": "query",
                "description": "Token for the next page of results"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sort order for feed elements"
              }
            ]
          },
          "docs": "Returns the news feed for the current user. The news feed includes updates from people and records the user follows, groups the user belongs to, and the user's own posts."
        },
        {
          "info": {
            "name": "Salesforce Sales Cloud Get feed for a specific record",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v59.0/analytics/chatter/feeds/record/:recordId/feed-elements",
            "params": [
              {
                "name": "recordId",
                "value": "",
                "type": "path",
                "description": "The ID of the record"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query"
              },
              {
                "name": "pageToken",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns the feed associated with the specified record. The record feed includes posts, comments, and tracked changes for the record."
        }
      ]
    }
  ],
  "bundled": true
}