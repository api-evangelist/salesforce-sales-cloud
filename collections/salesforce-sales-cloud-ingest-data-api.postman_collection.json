          "request": {
            "name": "Salesforce Sales Cloud Upload data for an ingest job",
            "description": {
              "content": "Uploads CSV data for an ingest job. The job must be in the Open state. You can upload data in multiple requests, each up to 150 MB. The CSV data must include a header row with field API names.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "jobs",
                "ingest",
                ":jobId",
                "batches"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "jobId",
                  "description": "(Required) The ID of the bulk job"
                },
                {
                  "description": "Your Salesforce instance identifier",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "text/csv"
              },
              {
                "key": "Accept",
                "value": "application/json"
