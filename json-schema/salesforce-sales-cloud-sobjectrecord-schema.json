{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/SObjectRecord",
  "title": "SObjectRecord",
  "type": "object",
  "description": "An sObject record with attributes and field values",
  "properties": {
    "attributes": {
      "type": "object",
      "properties": {
