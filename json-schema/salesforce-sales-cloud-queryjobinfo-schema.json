{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/QueryJobInfo",
  "title": "QueryJobInfo",
  "type": "object",
  "description": "Detailed information about a query job",
  "properties": {
    "id": {
      "type": "string"
    },
    "operation": {
      "type": "string",
      "enum": [
        "query",
        "queryAll"
      ]
    },
    "object": {
      "type": "string"
    },
    "createdById": {
      "type": "string"
    },
    "createdDate": {
      "type": "string",
      "format": "date-time"
    },
    "systemModstamp": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "type": "string",
      "enum": [
        "UploadComplete",
        "InProgress",
        "JobComplete",
        "Aborted",
        "Failed"
      ]
    },
    "concurrencyMode": {
      "type": "string"
    },
    "contentType": {
      "type": "string"
    },
    "apiVersion": {
      "type": "number"
    },
    "jobType": {
      "type": "string"
    },
    "lineEnding": {
      "type": "string"
    },
    "columnDelimiter": {
      "type": "string"
    },
    "numberRecordsProcessed": {
      "type": "integer"
    },
    "retries": {
      "type": "integer"
    },
    "totalProcessingTime": {
      "type": "integer"
    }
  }
}