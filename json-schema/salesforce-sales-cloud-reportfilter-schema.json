{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ReportFilter",
  "title": "ReportFilter",
  "type": "object",
  "description": "A filter applied to a report",
  "properties": {
    "column": {
      "type": "string"
    },
    "filterType": {
      "type": "string"
    },
    "isRunPageEditable": {
      "type": "boolean"
    },
    "operator": {
      "type": "string",
      "enum": [
        "equals",
        "notEqual",
        "lessThan",
        "greaterThan",
        "lessOrEqual",
        "greaterOrEqual",
        "contains",
        "notContain",
        "startsWith",
        "includes",
        "excludes"
      ]
    },
    "value": {
      "type": "string"
    }
  }
}