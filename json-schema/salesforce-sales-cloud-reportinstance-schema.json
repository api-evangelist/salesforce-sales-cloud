{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ReportInstance",
  "title": "ReportInstance",
  "type": "object",
  "description": "Information about an asynchronous report execution instance",
  "properties": {
    "completionDate": {
      "type": "string",
      "format": "date-time",
      "nullable": true
    },
    "id": {
      "type": "string"
    },
    "ownerId": {
      "type": "string"
    },
    "requestDate": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Success",
        "Running",
        "Error"
      ]
    },
    "url": {
      "type": "string"
    }
  }
}