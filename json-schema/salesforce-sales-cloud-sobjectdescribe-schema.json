            "nullable": true
          },
          "restrictedDelete": {
            "type": "boolean"
          }
        }
      }
    },
    "compactLayoutable": {
      "type": "boolean"
    },
    "createable": {
      "type": "boolean"
    },
    "custom": {
      "type": "boolean"
    },
    "customSetting": {
      "type": "boolean"
    },
    "deletable": {
      "type": "boolean"
    },
    "deprecatedAndHidden": {
      "type": "boolean"
    },
