      "type": "boolean"
    },
    "retrieveable": {
      "type": "boolean"
    },
    "searchLayoutable": {
      "type": "boolean"
    },
    "searchable": {
      "type": "boolean"
    },
    "triggerable": {
      "type": "boolean"
    },
    "undeletable": {
      "type": "boolean"
    },
