    "keyPrefix": {
      "type": "string",
      "nullable": true
    },
    "label": {
      "type": "string"
    },
    "labelPlural": {
      "type": "string"
    },
    "layoutable": {
      "type": "boolean"
    },
    "listviewable": {
      "type": "boolean"
    },
    "lookupLayoutable": {
      "type": "boolean"
    },
    "mergeable": {
      "type": "boolean"
    },
